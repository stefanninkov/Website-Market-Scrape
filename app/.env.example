# Firebase web app config (Firebase console → Project settings → Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Owner lock — the only Google account allowed into the app UI.
# Firestore security rules enforce the same email server-side.
VITE_OWNER_EMAIL=stefan.ninkov@gmail.com
