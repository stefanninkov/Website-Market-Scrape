# Cloud Functions runtime config (deployed via `firebase deploy`; for v2
# functions put real values in functions/.env — gitignored).

# Gmail OAuth client (GCP console → Credentials → OAuth client, type Web app;
# authorized redirect URI must be {APP_BASE_URL}/gmailAuthCallback)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Public base URL of the deployed app (used for the tracking pixel + OAuth
# redirects). Defaults to https://{project-id}.web.app when unset.
APP_BASE_URL=
