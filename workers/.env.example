# Google Cloud API keys (same GCP project as Firebase)
GOOGLE_PLACES_API_KEY=
PAGESPEED_API_KEY=

# Anthropic API (email drafts + preview copy, Phase 3+)
ANTHROPIC_API_KEY=

# Gmail OAuth client (same values as functions/.env) — used by the cron worker
# for the 30-min reply-polling fallback and Gmail watch renewal
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Pub/Sub topic short name for Gmail push notifications
PUBSUB_TOPIC=gmail-replies
# GCP project id (for the fully-qualified topic name)
GCLOUD_PROJECT=

# Path to the Firebase service account JSON (Project settings → Service accounts)
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json

# Public base URL of the deployed app, used to build preview URLs
# e.g. https://your-project.web.app
APP_BASE_URL=

# Optional: pin the Chromium binary the analyzer launches (defaults to
# Playwright's bundled browser). Set on VPS images that ship their own Chromium.
# PLAYWRIGHT_CHROMIUM_PATH=/opt/pw-browsers/chromium
